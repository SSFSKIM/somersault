#!/bin/sh
# Engine B — the same pinned payload extracted from the binary's $bunfs section
# and run as plain JS under bun (the compile target; under node it exits
# silently). Identical application code to engine-real, different packaging: the
# differ's self-test pair, and the substrate the strangler progressively replaces.
# Since 2.1.248 the payload is an ESM chunk graph whose /$bunfs/root/ specifiers
# only resolve inside the binary, so prepare.ts materializes a rewritten copy.
GRAPH="$(dirname "$0")/../build/graph/cli"
[ -e "$GRAPH" ] || { echo "reforge: graph not materialized — run 'npx tsx strangle/prepare.ts'" >&2; exit 127; }
# The runtime is PINNED to the version the oracle binary embeds (src/pin.ts,
# spec §3.5); BUN arrives through the allowlisted child env (X6). The fallback
# is the project-local toolchain, never the operator's ~/.bun.
BUN="${BUN:-$(dirname "$0")/../toolchain/bun}"
[ -x "$BUN" ] || { echo "reforge: pinned bun missing at $BUN — run 'npx tsx strangle/toolchain.ts'" >&2; exit 127; }
exec "$BUN" "$GRAPH" "$@"
