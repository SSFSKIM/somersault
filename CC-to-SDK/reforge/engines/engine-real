#!/bin/sh
# Engine A — the pinned real Claude Code binary (bun-compiled Mach-O): the oracle.
# No extension on this file: sdk.mjs treats a non-.js path as a native binary and
# spawns it directly, so this shebang runs. The pinned version lives in
# src/pin.ts alone; prepare.ts materializes build/real-binary from it.
ENGINE="$(dirname "$0")/../build/real-binary"
[ -e "$ENGINE" ] || { echo "reforge: engines not materialized — run 'npx tsx strangle/prepare.ts'" >&2; exit 127; }
exec "$ENGINE" "$@"
