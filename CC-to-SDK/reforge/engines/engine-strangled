#!/bin/sh
# Engine C — the strangled build: the extracted graph with each manifest method
# excised and delegated to a reforge-owned module (see strangle/). Built by
# `npx tsx strangle/build.ts [--sabotage <name>]`; graded by the same corpus.
GRAPH="$(dirname "$0")/../build/strangled/cli"
[ -e "$GRAPH" ] || { echo "reforge: no strangled build — run 'npx tsx strangle/build.ts'" >&2; exit 127; }
exec /Users/new/.bun/bin/bun "$GRAPH" "$@"
