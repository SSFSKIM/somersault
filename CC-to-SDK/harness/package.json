{
  "name": "cc-harness",
  "version": "0.1.0",
  "description": "Headless TypeScript harness over the Claude Agent SDK with Claude Code-faithful defaults — one-shot runs, interactive sessions, a multi-session daemon, hooks, swarm, and durable tasks.",
  "keywords": [
    "claude",
    "claude-code",
    "claude-agent-sdk",
    "anthropic",
    "agent",
    "llm",
    "ai",
    "harness",
    "headless"
  ],
  "homepage": "https://github.com/SSFSKIM/codex_somersault/tree/main/CC-to-SDK/harness#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SSFSKIM/codex_somersault.git",
    "directory": "CC-to-SDK/harness"
  },
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./appserver": {
      "types": "./dist/appserver/index.d.ts",
      "import": "./dist/appserver/index.js"
    },
    "./appserver/schema/stable.json": "./schema/json/stable/appserver.json",
    "./appserver/schema/experimental.json": "./schema/json/experimental/appserver.json",
    "./package.json": "./package.json"
  },
  "bin": {
    "cc-harness": "./dist/cli.js",
    "ccx": "./dist/cli/bin.js"
  },
  "files": [
    "dist",
    "schema"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "prepack": "npm run build",
    "verify:pack": "node scripts/verify-package.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run test/unit",
    "test:tui": "vitest run test/tui",
    "test:integration": "vitest run test/integration",
    "test:contract": "vitest run test/contract",
    "test:live": "vitest run test/live",
    "test:resize-matrix": "bash scripts/resize-matrix.sh",
    "test:hover-cells": "bash scripts/hover-cells.sh",
    "emit-schema": "node scripts/emit-appserver-schema.mjs",
    "cli": "tsx src/cli.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.237",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "diff": "9.0.0",
    "highlight.js": "11.11.1",
    "ink": "^5.0.1",
    "ink-text-input": "^6.0.0",
    "marked": "18.0.7",
    "react": "^18.3.1",
    "string-width": "^7.2.0",
    "wrap-ansi": "9.0.2",
    "ws": "^8.18.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/ws": "^8.5.12",
    "ajv": "^8.20.0",
    "ink-testing-library": "^4.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
