{
  "redactions_by_frame": {
    "help-overlay/*.ansi": {
      "patterns": [
        {
          "name": "greeting",
          "pattern": "Welcome back [^!\\x1b]*!(?=\\x1b\\[0m\\s+\\x1b\\[[0-9;]*m│\\x1b\\[0m Ask Claude to create)",
          "replacement": "▒",
          "minimum_matches": 1
        },
        {
          "name": "organization-email",
          "pattern": "(?:\\x1b\\[[0-9;]*m)?[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}(?:\\x1b\\[[0-9;]*m)?(?='s Organization\\x1b\\[0m +\\x1b\\[[0-9;]*m│\\x1b\\[0m {1,2}\\x1b\\[0;3;[0-9;]*m/release-notes)",
          "replacement": "▒",
          "minimum_matches": 1
        },
        {
          "name": "status-user-host",
          "pattern": "(?<=\\x1b\\[0m  )(?!git@)(?:\\x1b\\[[0-9;]*m)?[A-Za-z0-9._-]+@[A-Za-z0-9.-]+(?=\\x1b\\[[0-9;]*m:\\x1b\\[[0-9;]*m/)",
          "replacement": "▒",
          "minimum_matches": 1
        }
      ],
      "minimum_matches": 3
    },
    "composer-basics/*.ansi": {
      "patterns": [
        {
          "name": "greeting",
          "pattern": "Welcome back [^!\\x1b]*!(?=\\x1b\\[0m\\s+\\x1b\\[[0-9;]*m│\\x1b\\[0m Ask Claude to create)",
          "replacement": "▒",
          "minimum_matches": 1
        },
        {
          "name": "organization-email",
          "pattern": "(?:\\x1b\\[[0-9;]*m)?[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}(?:\\x1b\\[[0-9;]*m)?(?='s Organization\\x1b\\[0m +\\x1b\\[[0-9;]*m│\\x1b\\[0m {1,2}\\x1b\\[0;3;[0-9;]*m/release-notes)",
          "replacement": "▒",
          "minimum_matches": 1
        },
        {
          "name": "status-user-host",
          "pattern": "(?<=\\x1b\\[0m  )(?!git@)(?:\\x1b\\[[0-9;]*m)?[A-Za-z0-9._-]+@[A-Za-z0-9.-]+(?=\\x1b\\[[0-9;]*m:\\x1b\\[[0-9;]*m/)",
          "replacement": "▒",
          "minimum_matches": 1
        }
      ],
      "minimum_matches": 3
    }
  },
  "by_frame": {
    "help-overlay/*.ansi": [
      {
        "pattern": "(^\\x1b\\[0m {28}\\x1b\\[[0-9;]*mYou've used )\\d+%( of your weekly limit · resets )[^\\x1b\\n]+(\\x1b\\[0m$)",
        "replacement": "\\g<1>▒\\g<2>▒\\g<3>"
      },
      {
        "pattern": "(\\x1b\\[[0-9;]*m\\[[^\\]\\x1b]+\\]\\x1b\\[[0-9;]*m \\x1b\\[[0-9;]*m)\\$\\d+(?:\\.\\d+)?(\\x1b\\[[0-9;]*m · \\x1b\\[[0-9;]*m)\\d+(?:\\.\\d+)?s(?=\\x1b\\[0m$)",
        "replacement": "\\g<1>▒\\g<2>▒"
      }
    ],
    "composer-basics/*.ansi": [
      {
        "pattern": "(^\\x1b\\[0m {28}\\x1b\\[[0-9;]*mYou've used )\\d+%( of your weekly limit · resets )[^\\x1b\\n]+(\\x1b\\[0m$)",
        "replacement": "\\g<1>▒\\g<2>▒\\g<3>"
      },
      {
        "pattern": "(\\x1b\\[[0-9;]*m\\[[^\\]\\x1b]+\\]\\x1b\\[[0-9;]*m \\x1b\\[[0-9;]*m)\\$\\d+(?:\\.\\d+)?(\\x1b\\[[0-9;]*m · \\x1b\\[[0-9;]*m)\\d+(?:\\.\\d+)?s(?=\\x1b\\[0m$)",
        "replacement": "\\g<1>▒\\g<2>▒"
      }
    ]
  }
}
